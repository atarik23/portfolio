---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/about', label: 'about' },
  { href: '/work', label: 'work' },
  { href: '/journey', label: 'journey' },
  { href: '/elsewhere', label: 'elsewhere' },
];
---
<header class="site-header">
  <nav class="navbar" aria-label="Main navigation">
    <a class="navbar__name" href="/" aria-label="Tarik Agić, home">ta<span class="navbar__dot">.</span></a>
    <div class="navbar__links">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header { border-bottom: 1px solid #242320; }
  .navbar { width: min(1200px, calc(100% - 48px)); min-height: 82px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .navbar__name { font-size: 1.45rem; font-weight: 700; letter-spacing: -.09em; line-height: 1; }
  .navbar__dot { color: var(--accent); }
  .navbar__links { display: flex; align-items: center; gap: clamp(14px, 3vw, 38px); }
  .navbar__links a { color: var(--muted); font-size: .86rem; transition: color 180ms ease; }
  .navbar__links a:hover, .navbar__links a[aria-current="page"] { color: var(--text); }
  @media (max-width: 560px) {
    .navbar { min-height: 72px; flex-wrap: wrap; padding: 17px 0; gap: 16px; }
    .navbar__links { width: 100%; justify-content: space-between; gap: 10px; }
    .navbar__links a { font-size: .78rem; }
  }
</style>
