---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
    title?: string;
}

const { title = 'Tarik Agić' } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Personal website of Tarik Agić."
        />
        <title>{title}</title>
    </head>

    <body>
        <Navbar />
        <slot />
		<Footer />
    </body>
</html>