---
import Layout from '../layouts/Layout.astro';

// Add your own photographs to public/images/about/ using these filenames.
// Until then, the image slots display a subtle placeholder.
const interests = [
  { title: 'Football', detail: 'On the pitch or watching a match.', image: '/images/about/football.jpg', alt: 'A football moment' },
  { title: 'Chess', detail: 'A game I keep coming back to.', image: '/images/about/chess.jpg', alt: 'Chess board' },
  { title: 'Skiing', detail: 'My favorite way to spend a winter day.', image: '/images/about/skiing.jpg', alt: 'Skiing in the mountains' },
  { title: 'Travel', detail: 'New places, familiar curiosity.', image: '/images/about/travel.jpg', alt: 'A place from my travels' },
];
---

<Layout title="about — Tarik Agić">
  <main class="about-page">
    <header class="about-header">
      <p class="eyebrow">04 / about</p>
      <h1>A little about me.</h1>
      <p class="subtitle">A few things that don't fit neatly on a CV.</p>
    </header>

    <section class="intro" aria-labelledby="intro-heading">
      <div class="section-label" id="intro-heading">a short introduction</div>
      <div class="intro-copy">
        <p class="lead">I'm Tarik, a Data Science & AI student from Sarajevo.</p>
        <p>I grew up enjoying mathematics and physics, especially the kind of problems that take a while to figure out. Over time, that curiosity led me to programming and machine learning.</p>
        <p>I'm interested in more than one field, and I like finding opportunities to learn something new — whether that's through a project, a conversation, or a place I've never been.</p>
      </div>
    </section>

    <section class="interests" aria-labelledby="interests-heading">
      <div class="section-top">
        <h2 id="interests-heading">Away from the screen</h2>
        <span>four things I enjoy</span>
      </div>
      <div class="interests-grid">
        {interests.map((item, index) => (
          <article class="interest">
            <div class="interest-image" data-placeholder={item.title}>
              <img src={item.image} alt={item.alt} loading="lazy" onerror="this.style.display='none'" />
            </div>
            <div class="interest-meta">
              <div class="interest-heading"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3></div>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="photo-note">Personal photos will go here — no stock images.</p>
    </section>

    <section class="places" aria-labelledby="places-heading">
      <div class="section-label">a little further afield</div>
      <div class="places-copy">
        <h2 id="places-heading">Places & people</h2>
        <p>I've been fortunate to travel for competitions, conferences, and youth programs. The best part is usually the people I meet along the way.</p>
      </div>
      <div class="travel-photo" data-placeholder="a photo from my travels">
        <img src="/images/about/places.jpg" alt="A photograph from my travels" loading="lazy" onerror="this.style.display='none'" />
      </div>
    </section>

    <section class="closing" aria-label="Personal motto">
      <div><span class="section-label">a thought I like</span><h2>Panta Rei.</h2></div>
      <p>Everything flows. <span>πάντα ῥεῖ</span></p>
    </section>
  </main>
</Layout>

<style is:global>
  .about-page { width: min(1200px, calc(100% - 48px)); margin: 0 auto; min-width: 0; }
  .eyebrow, .section-label { color: #85817e; font-size: .78rem; letter-spacing: .09em; font-weight: 400; }
  .about-header { padding: 78px 0 52px; border-bottom: 1px solid #282828; }
  .about-header .eyebrow { margin: 0 0 18px; }
  .about-header h1 { margin: 0; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.06; letter-spacing: -.055em; font-weight: 500; }
  .subtitle { margin: 18px 0 0; color: #96918e; font-size: .98rem; }
  .intro { display: grid; grid-template-columns: 29% minmax(0,1fr); gap: 30px; padding: 56px 0 64px; border-bottom: 1px solid #282828; }
  .intro-copy { max-width: 750px; }
  .intro-copy p { margin: 0 0 17px; color: #a9a5a1; font-size: .99rem; line-height: 1.7; }
  .intro-copy .lead { color: #f0ede8; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1.3; letter-spacing: -.035em; margin-bottom: 23px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 24px; }
  .section-top h2, .places h2 { font-size: clamp(1.5rem, 2.5vw, 2.1rem); letter-spacing: -.04em; font-weight: 500; margin: 0; }
  .section-top span { color: #85817e; font-size: .8rem; }
  .interests { padding: 58px 0 62px; border-bottom: 1px solid #282828; }
  .interests-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 18px; }
  .interest { min-width: 0; }
  .interest-image { width: 100%; aspect-ratio: 4 / 3; position: relative; overflow: hidden; background: #161616; border: 1px solid #282828; }
  .interest-image::before, .travel-photo::before { content: attr(data-placeholder); position: absolute; inset: 0; display: grid; place-items: center; color: #555; font-size: .8rem; letter-spacing: .02em; text-align: center; padding: 12px; }
  .interest-image img, .travel-photo img { display: block; width: 100%; height: 100%; object-fit: cover; position: relative; z-index: 1; transition: transform .35s ease; }
  .interest:hover img { transform: scale(1.04); }
  .interest-meta { padding: 14px 0 0; }
  .interest-heading { display: flex; align-items: baseline; gap: 12px; }
  .interest-heading span { color: #777; font-size: .72rem; }
  .interest-heading h3 { margin: 0; font-size: 1.2rem; font-weight: 500; letter-spacing: -.03em; }
  .interest-meta p { margin: 8px 0 0 28px; color: #888; font-size: .82rem; line-height: 1.5; }
  .photo-note { color: #686868; font-size: .75rem; margin: 20px 0 0; }
  .places { display: grid; grid-template-columns: 23% minmax(0,1fr) minmax(220px,34%); gap: 30px; align-items: start; padding: 60px 0; border-bottom: 1px solid #282828; }
  .places-copy p { color: #a09c98; line-height: 1.7; font-size: .95rem; max-width: 380px; }
  .travel-photo { position: relative; background: #161616; border: 1px solid #282828; aspect-ratio: 16 / 9; overflow: hidden; }
  .closing { display: flex; justify-content: space-between; align-items: end; gap: 30px; padding: 55px 0 75px; }
  .closing h2 { font-size: clamp(2.2rem, 4.5vw, 4rem); line-height: 1; letter-spacing: -.055em; font-weight: 500; margin: 13px 0 0; }
  .closing p { margin: 0; color: #aaa; font-size: .9rem; }
  .closing p span { margin-left: 12px; color: #777; }
  @media (max-width: 850px) {
    .interests-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .places { grid-template-columns: 1fr 1fr; }
    .places > .section-label { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .about-page { width: calc(100% - 36px); }
    .about-header { padding: 54px 0 40px; }
    .intro { grid-template-columns: 1fr; gap: 20px; padding: 40px 0; }
    .interests { padding: 42px 0; }
    .interests-grid { gap: 22px 12px; }
    .interest-heading h3 { font-size: 1.05rem; }
    .interest-meta p { margin-left: 0; }
    .section-top span { display: none; }
    .places { grid-template-columns: 1fr; gap: 18px; padding: 42px 0; }
    .places > .section-label { grid-column: auto; }
    .closing { align-items: start; flex-direction: column; padding: 42px 0 60px; gap: 22px; }
  }
</style>
