---
import Layout from '../layouts/Layout.astro';

const experience = [
    {
        period: 'Mar 2026 — May 2026',
        role: 'AI Full-Stack Developer',
        organization: 'Next IT d.o.o.',
        description:
            'Worked as part of a collaborative development team on a full-stack AI-powered web application, spanning frontend, backend, data, and LLM integration.',
        tags: ['React', 'TypeScript', 'FastAPI', 'PostgreSQL', 'LLMs'],
    },
    {
        period: 'Sep 2025 — Jan 2026',
        role: 'Teaching Assistant',
        organization: 'Faculty of Electrical Engineering, University of Sarajevo',
        description:
            'Teaching Assistant for the Fundamental Concepts of AI course.',
        tags: ['Artificial Intelligence', 'Teaching'],
    },
];

const projects = [
    {
        year: '2025–2026',
        title: 'Bosančica AI',
        type: 'Research · Computer Vision / HTR',
        description:
            'A research pipeline for recognizing historical Bosančica manuscripts, comparing Kraken, TrOCR, and an adapted HTR-VT model.',
        status: 'collaborative research',
        href: 'https://bosancica.ai',
        linkLabel: 'Project website ↗',
        detailsHref: '/work/bosancica-ai',
    },
    {
        year: '2026',
        title: 'Uchko',
        type: 'Artificial Intelligence · Adaptive Learning',
        description:
            'An adaptive mathematics learning platform integrating XGBoost, Bayesian Knowledge Tracing, and a Django application for personalized practice and student progress tracking.',
        status: 'team project',
        detailsHref: '/work/uchko',
    },
    {
        year: '2026',
        title: 'Pizzo',
        type: 'Artificial Intelligence · C++',
        description:
            'A gamified route-planning application combining the Chinese Postman Problem, animated neighborhood traversal, and a Blackjack mini-game with an expected-value decision advisor.',
        status: 'academic project',
        href: 'https://github.com/atarik23/ProjAI_Pizzo_Agic',
        linkLabel: 'GitHub ↗',
        detailsHref: '/work/pizzo',
    },
    {
        year: '2025',
        title: '8-bit Digital Arithmetic System',
        type: 'Digital Logic · Formal Verification',
        description:
            'Designed and built an 8-bit arithmetic system using discrete logic components, with dual operand registers, selectable clock sources, and exhaustive EFSM verification.',
        status: 'team project',
        detailsHref: '/work/8-bit-digital-arithmetic-system',
    },
    {
        year: '2026',
        title: 'Mean-Variance Portfolio Optimizer',
        type: 'C++ · Numerical Optimization',
        description:
            'A C++ portfolio explorer that formulates long-only mean-variance allocation as a convex quadratic program, solves it with an active-set method, and compares natID dense and sparse KKT backends.',
        status: 'academic project',
        href: 'https://github.com/atarik23/ProjNO_PortOpt_Agic',
        linkLabel: 'GitHub ↗',
        detailsHref: '/work/mean-variance-portfolio-optimizer',
    },
    {
        year: '2026',
        title: 'Variational Autoencoders for Handwritten Digit Generation',
        type: 'Machine Learning · Generative Models',
        description:
            'Implemented and compared four autoencoder-based models for MNIST digit reconstruction and generation, investigating reconstruction accuracy, latent-space dimensionality, interpolation, and convolutional architectures.',
        status: 'academic project',
        href: 'https://github.com/atarik23/vae-mnist-digit-generation',
        linkLabel: 'GitHub ↗',
        detailsHref: '/work/vae-mnist-digit-generation',
    },
];
---

<Layout title="work — Tarik Agić">
    <main>
        <header class="page-header">
            <p>01 / work</p>

            <h1>Things I've worked on.</h1>

            <span>
                Professional work, teaching, research, and things I've built
                along the way.
            </span>
        </header>

        <section class="section">
            <div class="section__title">
                <p>experience</p>
                <span>professional & teaching</span>
            </div>

            <div class="experience-list">
                {experience.map((item) => (
                    <article class="experience-item">
                        <p class="period">{item.period}</p>

                        <div class="experience-item__content">
                            <h2>{item.role}</h2>

                            <p class="organization">
                                {item.organization}
                            </p>

                            <p class="description">
                                {item.description}
                            </p>

                            <div class="tags">
                                {item.tags.map((tag) => (
                                    <span>{tag}</span>
                                ))}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="section projects-section">
            <div class="section__title">
                <p>projects & research</p>
                <span>{projects.length} entries</span>
            </div>

            <div class="project-list">
                {projects.map((project, index) => (
                    <article class="project">
                        <div class="project__number">
                            {String(index + 1).padStart(2, '0')}
                        </div>

                        <div class="project__content">
                            <p class="project__type">
                                {project.type}
                            </p>

                            <h2>
                                {project.detailsHref ? (
                                    <a href={project.detailsHref} class="project__title-link">
                                        {project.title} <span aria-hidden="true">↗</span>
                                    </a>
                                ) : (
                                    project.title
                                )}
                            </h2>

                            <p class="project__description">
                                {project.description}
                            </p>

                            {project.href && (
                                <a
                                    class="project__link"
                                    href={project.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {project.linkLabel}
                                </a>
                            )}

                            {project.detailsHref && (
                                <a class="project__link project__details-link" href={project.detailsHref}>
                                    View project details →
                                </a>
                            )}
                        </div>

                        <div class="project__meta">
                            <span>{project.year}</span>
                            <span>{project.status}</span>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        min-height: 55vh;
        padding: 120px 0 80px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        border-bottom: 1px solid #282828;
    }

    .page-header > p,
    .section__title p {
        color: #777;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: lowercase;
    }

    .page-header h1 {
        max-width: 900px;
        margin: 20px 0 24px;
        font-size: clamp(3rem, 8vw, 7rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
        font-weight: 500;
    }

    .page-header > span {
        max-width: 600px;
        color: #888;
        line-height: 1.6;
    }

    .section {
        padding: 100px 0;
    }

    .section__title {
        display: flex;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: 40px;
        color: #777;
    }

    .section__title p,
    .section__title span {
        margin: 0;
    }

    .section__title span {
        font-size: 0.85rem;
    }

    /* EXPERIENCE */

    .experience-list,
    .project-list {
        border-top: 1px solid #282828;
    }

    .experience-item {
        display: grid;
        grid-template-columns: minmax(180px, 1fr) 3fr;
        gap: 48px;
        padding: 48px 0;
        border-bottom: 1px solid #282828;
    }

    .period {
        margin: 0;
        color: #777;
        font-size: 0.9rem;
    }

    .experience-item h2 {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.7rem);
        font-weight: 500;
        letter-spacing: -0.04em;
    }

    .organization {
        margin: 8px 0 28px;
        color: #999;
    }

    .description {
        max-width: 680px;
        margin: 0;
        color: #b0b0b0;
        line-height: 1.7;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 28px;
    }

    .tags span {
        padding: 7px 11px;
        border: 1px solid #333;
        border-radius: 999px;
        color: #999;
        font-size: 0.75rem;
    }

    /* PROJECTS */

    .projects-section {
        padding-bottom: 140px;
    }

    .project {
        position: relative;
        display: grid;
        grid-template-columns: 80px 1fr 180px;
        gap: 32px;
        padding: 48px 0;
        border-bottom: 1px solid #282828;
        transition:
            padding-left 180ms ease,
            background-color 180ms ease;
    }

    .project:hover {
        padding-left: 12px;
    }

    .project__number,
    .project__type,
    .project__meta {
        color: #777;
        font-size: 0.8rem;
    }

    .project__number {
        padding-top: 4px;
    }

    .project__type {
        margin: 0 0 10px;
    }

    .project h2 {
        margin: 0;
        font-size: clamp(1.8rem, 3.5vw, 3rem);
        font-weight: 500;
        letter-spacing: -0.045em;
    }

    .project__description {
        max-width: 680px;
        margin: 18px 0 0;
        color: #999;
        line-height: 1.65;
    }

    .project__meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-align: right;
    }

    .project__link {
        display: inline-block;
        margin-top: 24px;
        color: #999;
        font-size: 0.85rem;
        transition:
            color 180ms ease,
            transform 180ms ease;
    }

    .project__link:hover {
        color: #fff;
        transform: translateX(4px);
    }

    .project__title-link {
        color: inherit;
        text-decoration: none;
    }

    .project__title-link span {
        display: inline-block;
        color: #777;
        font-size: 0.55em;
        vertical-align: middle;
        transition: transform 180ms ease, color 180ms ease;
    }

    .project__title-link:hover span {
        color: #f1eee8;
        transform: translate(3px, -3px);
    }

    .project__details-link {
        margin-left: 24px;
        color: #f1eee8;
    }

    .project__title-link:focus-visible {
        outline: 2px solid #f26a2e;
        outline-offset: 5px;
    }

    @media (max-width: 700px) {
        .page-header {
            min-height: 45vh;
            padding-top: 80px;
        }

        .section {
            padding: 70px 0;
        }

        .projects-section {
            padding-bottom: 100px;
        }

        .section__title {
            flex-direction: column;
            gap: 8px;
        }

        .experience-item {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .project {
            grid-template-columns: 40px 1fr;
            gap: 20px;
        }

        .project:hover {
            padding-left: 0;
        }

        .project__meta {
            grid-column: 2;
            flex-direction: row;
            gap: 16px;
            text-align: left;
        }
    }
</style>