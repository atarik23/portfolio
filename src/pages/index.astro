---
import Layout from '../layouts/Layout.astro';

const highlights = [
  {
    meta: '01 / 2026 · AI',
    title: 'Raiffeisen AI Hackathon',
    description: '1st place',
    href: 'https://www.klix.ba/biznis/ai-rjesenja-koja-mijenjaju-bankarstvo-poznati-pobjednici-raiffeisen-ai-hackathona/260518102',
    external: true,
  },
  {
    meta: '02 / 2025–2026 · Community',
    title: 'Prolog',
    description: 'Organizer of two editions of a youth technology conference.',
    href: '/elsewhere',
    external: false,
  },
  {
    meta: '03 / Research · OCR / HTR',
    title: 'BosančicaAI',
    description: 'Collaborative research on OCR and HTR for historical Bosančica documents.',
    href: '/work',
    external: false,
  },
  {
    meta: '04 / 2025 · Teaching',
    title: 'Fundamental Concepts of AI',
    description: 'Teaching Assistant',
    href: '/work',
    external: false,
  },
];

const pages = [
  { number: '01', label: 'work', description: 'projects, research & experience', href: '/work' },
  { number: '02', label: 'journey', description: 'the timeline', href: '/journey' },
  { number: '03', label: 'elsewhere', description: 'science, community & more', href: '/elsewhere' },
  { number: '04', label: 'about', description: 'a little more about me', href: '/about' },
];
---

<Layout title="Tarik Agić">
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__topline">
        <span>Sarajevo, Bosnia & Herzegovina</span>
        <span>Personal website / 2026</span>
      </div>

      <div class="hero__composition">
        <div class="hero__identity">
          <h1 id="hero-title" class="hero__title"><span>Tarik</span><span>Agić</span></h1>
          <p class="hero__intro">Data Science & AI student exploring software, machine learning, research, and everything in between.</p>
        </div>

        <div class="hero__portrait" data-tilt-card>
          <img src="/images/tarik.jpg" alt="Portrait of Tarik Agić" fetchpriority="high" />
          <span class="hero__portrait-mark" aria-hidden="true">01 / portrait</span>
        </div>
      </div>
      <div class="hero__bottom">
        <span class="hero__bottom-rule" aria-hidden="true"></span>
        <p class="hero__status">Currently studying, teaching, building & organizing.</p>
      </div>
    </section>

    <section class="highlights" aria-labelledby="highlights-title">
      <div class="section-heading">
        <h2 id="highlights-title">selected highlights</h2>
        <p>A few things I've been up to.</p>
      </div>
      <div class="highlights__list">
        {highlights.map((item) => (
          <a class="highlight" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
            <span class="highlight__meta">{item.meta}</span>
            <div class="highlight__main"><h3>{item.title}</h3><p>{item.description}</p></div>
            <span class="highlight__arrow" aria-hidden="true">{item.external ? '↗' : '→'}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="explore" aria-labelledby="explore-title">
      <div class="section-heading">
        <h2 id="explore-title">explore</h2>
        <p>More than a list of projects.</p>
      </div>
      <div class="explore__links">
        {pages.map((page) => (
          <a href={page.href}>
            <span class="explore__number">{page.number}</span>
            <strong>{page.label}</strong>
            <span class="explore__description">{page.description}</span>
            <span class="explore__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero { padding: 54px 0 72px; border-bottom: 1px solid var(--line); }
  .hero__topline { display: flex; justify-content: space-between; gap: 24px; color: var(--muted); font-size: .75rem; letter-spacing: .035em; }
  .hero__composition { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); gap: clamp(30px, 6vw, 100px); align-items: center; min-height: 520px; padding: 56px 0 28px; }
  .hero__identity { align-self: center; min-width: 0; }
  .hero__title { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: clamp(6.5rem, 12vw, 11.5rem); font-weight: 600; letter-spacing: -.09em; line-height: .83; }
  .hero__title span { display: block; width: max-content; max-width: 100%; }
  .hero__title span:last-child { margin-left: clamp(18px, 5vw, 78px); }
  .hero__intro { max-width: 490px; margin: 38px 0 0; font-size: clamp(1.08rem, 1.5vw, 1.35rem); line-height: 1.48; letter-spacing: -.018em; }
  .hero__portrait { --rx: 0deg; --ry: 0deg; --lift: 0px; position: relative; justify-self: end; width: min(100%, 405px); aspect-ratio: 4 / 4.6; border-radius: 52px 52px 105px 52px; overflow: hidden; background: #1b1b1b; border: 1px solid #393735; transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(var(--lift)) rotate(2deg); transition: transform 400ms cubic-bezier(.2,.8,.2,1), border-radius 400ms ease, border-color 300ms ease; will-change: transform; }
  .hero__portrait:hover { --lift: -9px; border-radius: 72px 48px 72px 110px; border-color: #8b7565; }
  .hero__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 18%; filter: saturate(.83); transform: scale(1.025); transition: transform 500ms ease, filter 500ms ease; }
  .hero__portrait:hover img { transform: scale(1.085); filter: saturate(1); }
  .hero__portrait-mark { position: absolute; bottom: 22px; left: 25px; color: #fff; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; opacity: 0; transform: translateY(6px); transition: opacity 250ms ease, transform 250ms ease; text-shadow: 0 1px 8px #000; }
  .hero__portrait:hover .hero__portrait-mark { opacity: 1; transform: translateY(0); }
  .hero__bottom { display: flex; justify-content: flex-end; align-items: center; gap: 22px; }
  .hero__bottom-rule { width: 32px; height: 1px; background: var(--accent); }
  .hero__status { margin: 0; max-width: 280px; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  .highlights, .explore { padding: 90px 0; }
  .section-heading { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; margin-bottom: 34px; }
  .section-heading h2 { margin: 0; font-size: 1rem; font-weight: 500; letter-spacing: -.02em; }
  .section-heading p { margin: 0; color: var(--muted); font-size: .85rem; }
  .highlights__list, .explore__links { border-top: 1px solid var(--line); }
  .highlight { display: grid; grid-template-columns: 210px minmax(0, 1fr) 32px; gap: 24px; align-items: center; padding: 28px 4px; min-height: 116px; border-bottom: 1px solid var(--line); transition: background-color .2s ease, padding-left .2s ease; }
  .highlight:hover { background: #121212; padding-left: 14px; }
  .highlight__meta { color: var(--muted); font-size: .78rem; }
  .highlight__main h3 { margin: 0 0 7px; font-size: clamp(1.4rem, 2.7vw, 2.4rem); font-weight: 500; letter-spacing: -.05em; line-height: 1.1; }
  .highlight__main p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.45; }
  .highlight__arrow { font-size: 1.25rem; justify-self: end; transition: transform .2s ease, color .2s ease; }
  .highlight:hover .highlight__arrow { color: var(--accent); transform: translate(3px, -2px); }
  .explore { padding-top: 35px; }
  .explore__links a { display: grid; grid-template-columns: 65px minmax(0, 1fr) minmax(150px, 260px) 32px; gap: 20px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--line); transition: padding-left .2s ease; }
  .explore__links a:hover { padding-left: 14px; }
  .explore__number, .explore__description { color: var(--muted); font-size: .85rem; }
  .explore__links strong { font-size: clamp(2.1rem, 4.5vw, 4rem); font-weight: 500; letter-spacing: -.06em; line-height: 1.1; }
  .explore__arrow { font-size: 1.35rem; justify-self: end; transition: color .2s ease, transform .2s ease; }
  .explore__links a:hover .explore__arrow { color: var(--accent); transform: translate(3px, -2px); }
  @media (max-width: 950px) {
    .hero__composition { gap: 24px; min-height: 450px; }
    .hero__title { font-size: clamp(5rem, 12vw, 8.5rem); }
    .hero__portrait { border-radius: 36px 36px 75px 36px; }
    .highlight { grid-template-columns: 155px minmax(0, 1fr) 28px; }
    .explore__links a { grid-template-columns: 45px 1fr 26px; }
    .explore__description { display: none; }
  }
  @media (max-width: 650px) {
    .hero { padding: 32px 0 55px; }
    .hero__topline { font-size: .7rem; }
    .hero__topline span:last-child { display: none; }
    .hero__composition { grid-template-columns: 1fr; min-height: 0; gap: 36px; padding: 55px 0 25px; }
    .hero__title { font-size: clamp(5rem, 21vw, 8rem); }
    .hero__title span:last-child { margin-left: 9%; }
    .hero__intro { margin-top: 27px; font-size: 1.08rem; }
    .hero__portrait { width: min(77%, 340px); justify-self: end; aspect-ratio: 4 / 4.4; border-radius: 38px 38px 82px 38px; }
    .hero__bottom { justify-content: flex-start; }
    .highlights, .explore { padding: 70px 0; }
    .explore { padding-top: 0; }
    .section-heading { flex-direction: column; gap: 8px; }
    .highlight { grid-template-columns: 1fr 24px; gap: 8px; min-height: 120px; padding: 22px 4px; }
    .highlight__meta { grid-column: 1 / -1; }
    .highlight__main h3 { font-size: 1.65rem; }
    .highlight__arrow { grid-column: 2; grid-row: 2; }
    .explore__links a { grid-template-columns: 32px 1fr 24px; gap: 10px; }
    .explore__links strong { font-size: clamp(2.25rem, 10vw, 3.5rem); }
  }
  @media (max-width: 390px) { .hero__title { font-size: 20vw; } }
</style>

<script>
  const card = document.querySelector<HTMLElement>('[data-tilt-card]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (card && finePointer.matches && !reducedMotion.matches) {
    card.addEventListener('pointermove', (event: PointerEvent) => {
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      card.style.setProperty('--ry', `${x * 9}deg`);
      card.style.setProperty('--rx', `${-y * 9}deg`);
    });
    card.addEventListener('pointerleave', () => {
      card.style.setProperty('--rx', '0deg');
      card.style.setProperty('--ry', '0deg');
    });
  }
</script>
