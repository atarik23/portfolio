---

<Layout title="journey — Tarik Agić">
    <main>
        <header class="page-header">
            <p class="eyebrow">03 / journey</p>
            <h1>So far.</h1>
            <p class="page-intro">A timeline of education, research, competitions, and a few detours along the way.</p>
        </header>

        <section class="journey-list" aria-label="Journey timeline">
            {journey.map((period) => (
                <section class="journey-year" aria-label={period.year}>
                    <div class="journey-year-label">
                        <h2>{period.year}</h2>
                    </div>
                    <div class="journey-year-events">
                        {period.items.map((item) => (
                            <article class="journey-entry">
                                {item.image && (
                                    <div class="journey-thumb" aria-hidden="true">
                                        <img src={item.image} alt="" width="120" height="80" loading="lazy" decoding="async" />
                                    </div>
                                )}
                                <div class="journey-entry-copy">
                                    <p class="journey-category">{item.type}</p>
                                    <h3>
                                        {item.href ? (
                                            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
                                                {item.title}<span class="journey-arrow" aria-hidden="true">{item.external ? ' ↗' : ' →'}</span>
                                            </a>
                                        ) : item.title}
                                    </h3>
                                    <p class="journey-description">{item.description}</p>
                                </div>
                            </article>
                        ))}
                    </div>
                </section>
            ))}
        </section>
    </main>
</Layout>

<style>
    .page-header { padding: 92px 0 30px; border-bottom: 1px solid #292929; }
    .eyebrow { margin: 0 0 12px; color: #858585; font-size: .72rem; letter-spacing: .12em; }
    .page-header h1 { margin: 0 0 12px; font-size: clamp(3rem, 6vw, 5rem); font-weight: 500; letter-spacing: -.065em; line-height: 1; }
    .page-intro { max-width: 650px; margin: 0; color: #969696; font-size: .92rem; line-height: 1.55; }

    .journey-list { padding: 14px 0 70px; }
    .journey-year {
        display: grid;
        grid-template-columns: minmax(115px, 15%) minmax(0, 1fr);
        border-bottom: 1px solid #383838;
    }
    .journey-year-label {
        border-right: 1px solid #383838;
        padding: 18px 22px 18px 0;
    }
    .journey-year-label h2 {
        position: sticky;
        top: 110px;
        margin: 0;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 500;
        letter-spacing: -.045em;
        line-height: 1.2;
    }
    .journey-year-events {
        min-width: 0;
        padding-left: 24px;
    }
    .journey-year-events .journey-entry:last-child { border-bottom: 0; }

    .journey-entry {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 18px;
        padding: 11px 0;
        min-height: 102px;
        border-bottom: 1px solid #282828;
    }
    .journey-thumb {
        flex: 0 0 120px;
        width: 120px;
        height: 80px;
        min-width: 120px;
        max-width: 120px;
        overflow: hidden;
        border-radius: 2px;
        background: #1a1a1a;
        position: relative;
        isolation: isolate;
    }
    
    /* Orange border and subtle image zoom */
    .journey-thumb::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        background: transparent;
        box-shadow: inset 0 0 0 2px transparent;
        pointer-events: none;
        transition: box-shadow 0.3s ease;
    }

    .journey-thumb img {
        transition: transform 0.35s ease;
    }

    .journey-entry:hover .journey-thumb::after {
        opacity: 1;
        box-shadow: inset 0 0 0 2px #f26a2e;
    }

    .journey-entry:hover .journey-thumb img {
        transform: scale(1.07);
        filter: none;
    }

    .journey-thumb img {
        transition: transform 0.35s ease;
    }

    .journey-entry:hover .journey-thumb {
        outline-color: #f26a2e;
    }

    .journey-entry:hover .journey-thumb img {
        transform: scale(1.07);
    }
    .journey-thumb img {
        display: block;
        width: 120px !important;
        height: 80px !important;
        max-width: 120px !important;
        max-height: 80px !important;
        min-width: 120px;
        object-fit: cover;
        border-radius: 2px;
    }

    .journey-entry-copy { flex: 1 1 auto; min-width: 0; }
    .journey-category { margin: 0 0 4px; color: #999; font-size: .68rem; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase; }
    .journey-entry-copy h3 { margin: 0; color: #efefef; font-size: 1.05rem; font-weight: 500; line-height: 1.3; letter-spacing: -.015em; }
    .journey-entry-copy h3 a { color: inherit; text-decoration: none; }
    .journey-entry-copy h3 a:hover, .journey-entry-copy h3 a:focus-visible { color: #f26a2e; }
    .journey-entry-copy h3 a:focus-visible { outline: 2px solid #f26a2e; outline-offset: 4px; }
    .journey-arrow { color: #f26a2e; }
    .journey-description { margin: 5px 0 0; color: #999; font-size: .87rem; line-height: 1.45; }

    @media (max-width: 700px) {
        .page-header { padding: 80px 0 26px; }
        .journey-year { grid-template-columns: 72px minmax(0, 1fr); }
        .journey-year-label { padding: 14px 8px 14px 0; }
        .journey-year-label h2 { top: 85px; font-size: 1.25rem; }
        .journey-year-events { padding-left: 12px; }
        .journey-entry { gap: 12px; padding: 10px 0; min-height: 88px; }
        .journey-thumb { flex-basis: 88px; width: 88px; min-width: 88px; max-width: 88px; height: 66px; }
        .journey-thumb img { width: 88px !important; min-width: 88px; max-width: 88px !important; height: 66px !important; max-height: 66px !important; }
        .journey-entry-copy h3 { font-size: .95rem; }
        .journey-description { font-size: .78rem; }
    }
    @media (max-width: 430px) {
        .journey-year { grid-template-columns: 1fr; }
        .journey-year-label { border-right: 0; border-bottom: 1px solid #383838; padding: 16px 0 8px; }
        .journey-year-label h2 { position: static; }
        .journey-year-events { padding-left: 0; }
    }
</style>
