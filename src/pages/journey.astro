---

<Layout title="journey — Tarik Agić">
    <main>
        <header class="page-header">
            <p>03 / journey</p>

            <h1>So far.</h1>

            <span>
                A timeline of competitions, education, technology,
                research, community, and a few detours along the way.
            </span>
        </header>

        <section class="timeline">
            {journey.map((period) => (
                <div class="year">
                    <div class="year__label">
                        <span>{period.year}</span>
                    </div>

                    <div class="year__content">
                        {period.items.map((item) => (
                            item.href ? (
                                <a
                                    class="event event--linked"
                                    href={item.href}
                                    target={item.external ? '_blank' : undefined}
                                    rel={item.external ? 'noopener noreferrer' : undefined}
                                >
                                    <div class="event__top">
                                        <p class="event__type">{item.type}</p>
                                        <span class="event__action">
                                            {item.external ? '↗' : '→'}
                                        </span>
                                    </div>

                                    <h2>{item.title}</h2>

                                    <p class="event__description">
                                        {item.description}
                                    </p>
                                </a>
                            ) : (
                                <article class="event">
                                    <div class="event__top">
                                        <p class="event__type">{item.type}</p>
                                    </div>

                                    <h2>{item.title}</h2>

                                    <p class="event__description">
                                        {item.description}
                                    </p>
                                </article>
                            )
                        ))}
                    </div>
                </div>
            ))}
        </section>
    </main>
</Layout>

<style>
    .page-header {
        min-height: 55vh;
        padding: 120px 0 80px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        border-bottom: 1px solid #282828;
    }

    .page-header > p {
        color: #777;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: lowercase;
    }

    .page-header h1 {
        margin: 20px 0 24px;
        font-size: clamp(4rem, 10vw, 9rem);
        line-height: 0.9;
        letter-spacing: -0.07em;
        font-weight: 500;
    }

    .page-header > span {
        max-width: 600px;
        color: #888;
        line-height: 1.6;
    }

    .timeline {
        padding: 80px 0 140px;
    }

    .year {
        display: grid;
        grid-template-columns: 1fr 3fr;
        border-bottom: 1px solid #282828;
    }

    .year__label {
        padding: 48px 0;
        border-right: 1px solid #282828;
    }

    .year__label span {
        position: sticky;
        top: 120px;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .year__content {
        padding-left: 48px;
    }

    .event {
        position: relative;
        display: block;
        padding: 48px 0;
        border-bottom: 1px solid #202020;
    }

    .event:last-child {
        border-bottom: none;
    }

    .event__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        max-width: 760px;
    }

    .event__type {
        margin: 0 0 14px;
        color: #666;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: lowercase;
    }

    .event__action {
        color: #666;
        font-size: 0.9rem;
        opacity: 0;
        transform: translateX(-6px);
        transition:
            opacity 180ms ease,
            transform 180ms ease,
            color 180ms ease;
    }

    .event h2 {
        max-width: 700px;
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 500;
        letter-spacing: -0.04em;
        transition:
            transform 180ms ease,
            color 180ms ease;
    }

    .event__description {
        max-width: 600px;
        margin: 16px 0 0;
        color: #888;
        line-height: 1.6;
        transition: color 180ms ease;
    }

    .event--linked {
        cursor: pointer;
    }

    .event--linked:hover h2 {
        transform: translateX(8px);
        color: #fff;
    }

    .event--linked:hover .event__description {
        color: #aaa;
    }

    .event--linked:hover .event__action {
        opacity: 1;
        transform: translateX(0);
        color: #aaa;
    }

    @media (max-width: 700px) {
        .page-header {
            min-height: 45vh;
            padding-top: 80px;
        }

        .timeline {
            padding-top: 40px;
            padding-bottom: 100px;
        }

        .year {
            grid-template-columns: 1fr;
        }

        .year__label {
            padding: 40px 0 10px;
            border-right: none;
        }

        .year__label span {
            position: static;
        }

        .year__content {
            padding-left: 0;
        }

        .event__action {
            opacity: 1;
            transform: none;
        }

        .event--linked:hover h2 {
            transform: none;
        }
    }
</style>