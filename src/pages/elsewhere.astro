---
import Layout from '../layouts/Layout.astro';

const otherInvolvements = [
  { title: 'Limes', detail: 'High-school science and research magazine', tag: 'Editorial' },
  { title: 'BH Futures Foundation', detail: 'Alumni community', tag: 'Community' },
  { title: 'Festival & community volunteering', detail: 'Supporting cultural and community events', tag: 'Volunteering' },
];
---

<Layout title="elsewhere — Tarik Agić">
  <main class="elsewhere-page">
    <header class="elsewhere-hero">
      <p class="kicker">02 / elsewhere</p>
      <h1>Beyond the coursework.</h1>
      <p>Building communities, creating opportunities, and contributing to things bigger than a single project.</p>
    </header>

    <section class="elsewhere-section" aria-labelledby="ndvp-title">
      <div class="section-label"><span>01 / community & organizing</span><span>2025 — present</span></div>
      <div class="ndvp-intro">
        <div class="ndvp-heading">
          <p class="kicker">Naučno društvo „Vladimir Prelog“</p>
          <h2 id="ndvp-title">Making science more accessible.</h2>
        </div>
        <div class="ndvp-copy">
          <p>As Secretary of Informatics at the Scientific Society “Vladimir Prelog”, I help organize initiatives that bring students closer to science, technology, and people working in these fields.</p>
          <p>One of these initiatives is <strong>Prolog</strong>, a technology conference for high-school and university students, developed and organized within the Society.</p>
        </div>
      </div>

      <div class="prolog-heading"><h3>Prolog</h3><span>Two editions · Sarajevo</span></div>
      <div class="prolog-grid">
        <article class="prolog-card">
          <a class="prolog-visual" href="https://www.instagram.com/p/DKmq3yFsB_G/?img_index=4" target="_blank" rel="noopener noreferrer" aria-label="Prolog 2025 photos on Instagram">
            <img src="https://prolog.naucnodrustvo.org/images/audience1.webp" alt="Audience at Prolog 2025" loading="lazy" />
          </a>
          <div class="prolog-meta"><span>2025 / first edition</span><span>Sarajevo</span></div>
          <h4><a href="https://www.instagram.com/p/DKmq3yFsB_G/?img_index=4" target="_blank" rel="noopener noreferrer">Prolog 2025 <span aria-hidden="true">↗</span></a></h4>
          <p>Co-organized the first edition, bringing together more than 70 students from 13 cities for talks, hands-on activities, and conversations about technology.</p>
        </article>
        <article class="prolog-card">
          <a class="prolog-visual prolog-visual--poster" href="https://prolog.naucnodrustvo.org/" target="_blank" rel="noopener noreferrer" aria-label="Prolog 2026 official website">
            <span class="poster-kicker">Naučno društvo „Vladimir Prelog“</span>
            <span class="poster-title">PROLOG<span>2026</span></span>
            <span class="poster-foot">AI · computing · engineering</span>
          </a>
          <div class="prolog-meta"><span>2026 / second edition</span><span>Sarajevo</span></div>
          <h4><a href="https://prolog.naucnodrustvo.org/" target="_blank" rel="noopener noreferrer">Prolog 2026 <span aria-hidden="true">↗</span></a></h4>
          <p>Led the organizing committee for an expanded three-day conference featuring talks, practical workshops, and a student project expo.</p>
        </article>
      </div>
      <p class="photo-note">2025 photo: official Prolog website. The 2026 graphic is a temporary placeholder until an event photograph is selected.</p>
    </section>

    <section class="elsewhere-section elsewhere-section--last" aria-labelledby="other-title">
      <div class="section-label"><span>02 / other involvements</span></div>
      <h2 class="other-heading" id="other-title">Also along the way.</h2>
      <div class="other-list">
        {otherInvolvements.map((item) => (
          <article class="other-item">
            <span class="other-tag">{item.tag}</span>
            <div><h3>{item.title}</h3><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .elsewhere-page { width: min(1200px, calc(100% - 48px)); margin: 0 auto; min-width: 0; overflow-x: clip; }
  .elsewhere-page *, .elsewhere-page *::before, .elsewhere-page *::after { box-sizing: border-box; }
  .elsewhere-page img { display: block; max-width: 100%; }
  .elsewhere-page a { color: inherit; }
  .elsewhere-hero { padding: 64px 0 35px; border-bottom: 1px solid #292929; }
  .kicker, .section-label, .prolog-meta, .other-tag { color: #999; font-size: .76rem; letter-spacing: .09em; }
  .elsewhere-hero .kicker { margin: 0 0 16px; }
  .elsewhere-hero h1 { font-size: clamp(2.2rem, 4.3vw, 3.8rem); letter-spacing: -.065em; line-height: 1.02; font-weight: 500; margin: 0 0 16px; }
  .elsewhere-hero > p:last-child { max-width: 720px; color: #aaa; font-size: .97rem; line-height: 1.6; margin: 0; }
  .elsewhere-section { padding: 36px 0 52px; border-bottom: 1px solid #292929; }
  .section-label { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 30px; }
  .ndvp-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; align-items: start; margin-bottom: 34px; }
  .ndvp-heading .kicker { margin: 0 0 14px; }
  .ndvp-heading h2 { font-size: clamp(1.7rem, 2.8vw, 2.6rem); line-height: 1.1; letter-spacing: -.05em; font-weight: 500; margin: 0; max-width: 520px; }
  .ndvp-copy p { color: #aaa; font-size: .94rem; line-height: 1.7; margin: 0 0 14px; }
  .ndvp-copy strong { color: #f2eee9; font-weight: 500; }
  .prolog-heading { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid #292929; padding: 20px 0; gap: 16px; }
  .prolog-heading h3 { font-size: 1.55rem; font-weight: 500; margin: 0; letter-spacing: -.035em; }
  .prolog-heading span { color: #888; font-size: .78rem; }
  .prolog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .prolog-card { min-width: 0; }
  .prolog-visual { display: flex; position: relative; overflow: hidden; width: 100%; aspect-ratio: 16 / 9; background: #151515; text-decoration: none; }
  .prolog-visual::after { content: ''; position: absolute; inset: 0; z-index: 2; box-shadow: inset 0 0 0 2px transparent; pointer-events: none; transition: box-shadow .25s ease; }
  .prolog-visual:hover::after { box-shadow: inset 0 0 0 2px #f26a2e; }
  .prolog-visual img { width: 100%; height: 100%; min-width: 0; object-fit: cover; transition: transform .35s ease; }
  .prolog-visual:hover img { transform: scale(1.045); }
  .prolog-visual--poster { padding: 24px; flex-direction: column; justify-content: space-between; background: radial-gradient(circle at 85% 12%, #29333b, transparent 45%), #141a1e; }
  .poster-kicker, .poster-foot { color: #8c9ba4; font-size: .72rem; letter-spacing: .08em; }
  .poster-title { font-weight: 700; font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: .95; letter-spacing: -.07em; color: #f4f1eb; }
  .poster-title span { display: block; color: #f26a2e; font-size: .45em; letter-spacing: -.03em; margin-top: 8px; }
  .prolog-meta { display: flex; justify-content: space-between; margin: 15px 0 7px; gap: 12px; }
  .prolog-card h4 { font-size: 1.35rem; font-weight: 500; letter-spacing: -.03em; margin: 0 0 8px; }
  .prolog-card h4 a { color: inherit; text-decoration: none; }
  .prolog-card h4 a span { color: #f26a2e; }
  .prolog-card h4 a:hover { color: #f26a2e; }
  .prolog-card > p { color: #a5a5a5; font-size: .88rem; line-height: 1.6; margin: 0; max-width: 510px; }
  .photo-note { font-size: .73rem; color: #737373; margin: 15px 0 0; }
  .elsewhere-section--last { border-bottom: 0; padding-bottom: 100px; }
  .other-heading { font-size: clamp(1.8rem, 3vw, 2.7rem); font-weight: 500; letter-spacing: -.05em; margin: 0 0 25px; }
  .other-list { border-top: 1px solid #292929; }
  .other-item { display: grid; grid-template-columns: 175px 1fr; gap: 24px; padding: 19px 0; border-bottom: 1px solid #292929; }
  .other-tag { padding-top: 4px; }
  .other-item h3 { font-size: 1.05rem; font-weight: 500; margin: 0 0 5px; }
  .other-item p { color: #929292; font-size: .86rem; margin: 0; }
  @media (max-width: 700px) { .elsewhere-hero { padding-top: 65px; } .ndvp-intro, .prolog-grid { grid-template-columns: 1fr; gap: 22px; } .ndvp-intro { margin-bottom: 35px; } .section-label { margin-bottom: 22px; } .other-item { grid-template-columns: 100px 1fr; gap: 14px; } .prolog-visual--poster { min-height: 190px; } }
  @media (prefers-reduced-motion: reduce) { .prolog-visual img { transition: none; } }
</style>
