---
import Layout from '../layouts/Layout.astro';

const experiences = [
    {
        year: '2025',
        title: 'WeAreDevelopers World Congress',
        location: 'Berlin, Germany',
        type: 'technology conference',
    },
    {
        year: '2025',
        title: 'Eastern European Machine Learning Summer School',
        location: 'Sarajevo, Bosnia & Herzegovina',
        type: 'machine learning summer school',
    },
    {
        year: '2024',
        title: 'Loudoun International Youth Leadership Summit',
        location: 'Virginia, USA',
        type: 'international summit',
    },
    {
        year: '2022',
        title: 'European Digital Youth Summit',
        location: 'Bucharest, Romania',
        type: 'international program',
    },
    {
        year: '2022',
        title: 'STEM Youth Camp',
        location: 'Konjic, Bosnia & Herzegovina',
        type: 'STEM program',
    },
];

const involvement = [
    {
        title: 'BH Futures Foundation',
        type: 'community',
    },
    {
        title: 'European Youth Parliament',
        type: 'youth engagement',
    },
    {
        title: 'Model United Nations',
        type: 'youth engagement',
    },
    {
        title: 'Limes',
        type: 'science & research journal',
    },
    {
        title: 'STEM & mathematics camps',
        type: 'science',
    },
    {
        title: 'Festival & community volunteering',
        type: 'volunteering',
    },
];
---

<Layout title="elsewhere — Tarik Agić">
    <main>
        <header class="page-header">
            <p>02 / elsewhere</p>

            <h1>Beyond the coursework.</h1>

            <span>
                Science, community, conferences, organizing,
                and some of the places curiosity has taken me.
            </span>
        </header>

        <section class="community">
            <div class="section-heading">
                <p>community & leadership</p>
                <span>Sarajevo · 2025 — present</span>
            </div>

            <article class="feature">
                <div class="feature__meta">
                    <span>Scientific Association</span>
                    <span>Vladimir Prelog</span>
                </div>

                <div class="feature__content">
                    <p class="feature__eyebrow">
                        Naučno društvo "Vladimir Prelog"
                    </p>

                    <h2>Secretary of Informatics</h2>

                    <p>
                        Working on initiatives that connect young people
                        with science, technology, and opportunities to
                        learn, build, and collaborate.
                    </p>
                </div>
            </article>

            <div class="prolog-intro">
                <div>
                    <p>one of those initiatives</p>
                </div>

                <div>
                    <h2>Prolog</h2>

                    <p>
                        A technology conference for high-school and
                        university students, built around technology,
                        artificial intelligence, engineering, learning,
                        and community.
                    </p>
                </div>
            </div>

            <div class="prolog-grid">
                <article class="prolog-card">
                    <div class="prolog-card__top">
                        <span>01</span>
                        <span>2025</span>
                    </div>

                    <div>
                        <h3>Prolog 01</h3>

                        <p>
                            The first edition brought together students
                            interested in technology and AI for lectures,
                            practical sessions, and conversations with
                            people from academia and industry.
                        </p>
                    </div>
                </article>

                <article class="prolog-card">
                    <div class="prolog-card__top">
                        <span>02</span>
                        <span>2026</span>
                    </div>

                    <div>
                        <h3>Prolog 02</h3>

                        <p>
                            The second edition expanded Prolog into a
                            three-day conference covering technology,
                            AI, engineering, workshops, and community.
                        </p>
                    </div>
                </article>
            </div>
        </section>

        <section class="experiences">
            <div class="section-heading">
                <p>conferences & experiences</p>
                <span>{experiences.length} selected</span>
            </div>

            <div class="experience-list">
                {experiences.map((experience) => (
                    <article class="experience">
                        <span class="experience__year">
                            {experience.year}
                        </span>

                        <div class="experience__content">
                            <p>{experience.type}</p>
                            <h3>{experience.title}</h3>
                        </div>

                        <span class="experience__location">
                            {experience.location}
                        </span>
                    </article>
                ))}
            </div>
        </section>

        <section class="involvement">
            <div class="section-heading">
                <p>also along the way</p>
                <span>communities, programs & volunteering</span>
            </div>

            <div class="involvement-grid">
                {involvement.map((item, index) => (
                    <article class="involvement-item">
                        <div class="involvement-item__top">
                            <span>
                                {String(index + 1).padStart(2, '0')}
                            </span>

                            <span>{item.type}</span>
                        </div>

                        <p>{item.title}</p>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        min-height: 55vh;
        padding: 120px 0 80px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        border-bottom: 1px solid #282828;
    }

    .page-header > p,
    .section-heading p {
        color: #777;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: lowercase;
    }

    .page-header h1 {
        max-width: 900px;
        margin: 20px 0 24px;
        font-size: clamp(3rem, 8vw, 7rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
        font-weight: 500;
    }

    .page-header > span {
        max-width: 580px;
        color: #888;
        line-height: 1.6;
    }

    .community,
    .experiences,
    .involvement {
        padding: 100px 0;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: 40px;
        color: #777;
    }

    .section-heading p,
    .section-heading span {
        margin: 0;
    }

    .section-heading span {
        font-size: 0.85rem;
    }

    /* COMMUNITY */

    .feature {
        display: grid;
        grid-template-columns: 1fr 3fr;
        gap: 48px;
        padding: 56px 0 80px;
        border-top: 1px solid #282828;
    }

    .feature__meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
        color: #777;
        font-size: 0.8rem;
    }

    .feature__eyebrow {
        margin: 0 0 12px;
        color: #888;
    }

    .feature h2 {
        max-width: 850px;
        margin: 0;
        font-size: clamp(2.5rem, 6vw, 5.5rem);
        line-height: 0.95;
        font-weight: 500;
        letter-spacing: -0.06em;
    }

    .feature__content > p:last-child {
        max-width: 620px;
        margin: 32px 0 0;
        color: #999;
        line-height: 1.7;
    }

    /* PROLOG */

    .prolog-intro {
        display: grid;
        grid-template-columns: 1fr 3fr;
        gap: 48px;
        padding: 64px 0;
        border-top: 1px solid #282828;
    }

    .prolog-intro > div:first-child p {
        margin: 0;
        color: #777;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: lowercase;
    }

    .prolog-intro h2 {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .prolog-intro > div:last-child p {
        max-width: 650px;
        margin: 24px 0 0;
        color: #999;
        line-height: 1.7;
    }

    .prolog-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-top: 1px solid #282828;
        border-left: 1px solid #282828;
    }

    .prolog-card {
        min-height: 340px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid #282828;
        border-bottom: 1px solid #282828;
        transition: background-color 180ms ease;
    }

    .prolog-card:hover {
        background: #111;
    }

    .prolog-card__top {
        display: flex;
        justify-content: space-between;
        color: #777;
        font-size: 0.8rem;
    }

    .prolog-card h3 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 500;
        letter-spacing: -0.045em;
    }

    .prolog-card p {
        max-width: 470px;
        margin: 18px 0 0;
        color: #888;
        line-height: 1.6;
    }

    /* EXPERIENCES */

    .experience-list {
        border-top: 1px solid #282828;
    }

    .experience {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 32px;
        align-items: center;
        padding: 32px 0;
        border-bottom: 1px solid #282828;
        transition: padding-left 180ms ease;
    }

    .experience:hover {
        padding-left: 10px;
    }

    .experience__year,
    .experience__location,
    .experience p {
        color: #777;
        font-size: 0.8rem;
    }

    .experience p {
        margin: 0 0 7px;
    }

    .experience h3 {
        margin: 0;
        font-size: clamp(1.25rem, 2.5vw, 1.7rem);
        font-weight: 500;
        letter-spacing: -0.025em;
    }

    .experience__location {
        text-align: right;
    }

    /* INVOLVEMENT */

    .involvement {
        padding-bottom: 140px;
    }

    .involvement-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-top: 1px solid #282828;
        border-left: 1px solid #282828;
    }

    .involvement-item {
        min-height: 170px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid #282828;
        border-bottom: 1px solid #282828;
        transition: background-color 180ms ease;
    }

    .involvement-item:hover {
        background: #111;
    }

    .involvement-item__top {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        color: #666;
        font-size: 0.75rem;
    }

    .involvement-item p {
        margin: 32px 0 0;
        font-size: clamp(1.1rem, 2vw, 1.5rem);
        letter-spacing: -0.025em;
    }

    @media (max-width: 700px) {
        .page-header {
            min-height: 45vh;
            padding-top: 80px;
        }

        .community,
        .experiences,
        .involvement {
            padding: 70px 0;
        }

        .section-heading {
            flex-direction: column;
            gap: 8px;
        }

        .feature,
        .prolog-intro {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .prolog-grid,
        .involvement-grid {
            grid-template-columns: 1fr;
        }

        .prolog-card {
            min-height: 280px;
        }

        .experience {
            grid-template-columns: 60px 1fr;
            gap: 20px;
        }

        .experience:hover {
            padding-left: 0;
        }

        .experience__location {
            grid-column: 2;
            text-align: left;
        }

        .involvement {
            padding-bottom: 100px;
        }
    }
</style>